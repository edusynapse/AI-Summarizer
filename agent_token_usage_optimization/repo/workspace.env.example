# AI-Summarizer multi-repo workspace (LOCAL).
# Copy to workspace.env and edit. workspace.env is gitignored.
#
# Each sibling must be a separate checkout with its OWN skill install:
#   <sibling>/skills/agent_token_usage_optimization/
#     summaries/          — that repo's summaries only
#     repo/index.sqlite   — that repo's symbols only
#     repo/adjacency.sqlite — that repo's adjacency only
# Tools never merge those DBs into this repo.
#
# Load order: process env > workspace.env > defaults.

# Stable id for THIS checkout
WORKSPACE_REPO_ID=my-app

# Role hint: app | api | lib | other
WORKSPACE_ROLE=app

# Sibling checkouts: id=/absolute/or/~/path/to/repo_root (not skills/)
# Example:
# WORKSPACE_SIBLINGS=api=/home/me/work/my-api,web=/home/me/work/my-web
WORKSPACE_SIBLINGS=

# Dart/JS package import → lib/ mapping (optional)
# Example: know_to_win=package:know_to_win/
WORKSPACE_PACKAGE_PREFIXES=

# Optional future contract scan (0/1). Default 0.
WORKSPACE_CROSS_CONTRACTS=0
